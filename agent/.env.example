# 复制为 agent/.env 并填入。.env 已被根 .gitignore 忽略，切勿提交。
# ⚠️ 私钥仅由你本人填入并显式开启写链；Claude Code 不读写、不使用密钥。

# --- 运行上下文 ---
CHAIN_ID=5003
MANTLE_SEPOLIA_RPC_URL=               # 见 https://chainlist.org/chain/5003（留空则用内置默认）
REGISTRY_ADDRESS=                     # 部署后回填的 LPAgentRegistry 地址
AGENT_ID=1
OPERATOR_ADDRESS=                     # 该 agent 的 operator 公钥地址（simulate 用，无需私钥）
BYREAL_POOL_ID=                       # 目标 Byreal(Solana) 池地址 base58

# --- 策略阈值（留空则用 DEFAULT_STRATEGY）---
STRAT_RANGE_WIDTH_PCT=
STRAT_WIDE_RANGE_WIDTH_PCT=
STRAT_REBALANCE_UTIL=
STRAT_HIGH_VOL_PCT=
STRAT_CLAIM_FEES_USD=
STRAT_MAX_IL_PCT=

# --- AI 决策叙述（可选；留空用 MockReasoner）---
ANTHROPIC_API_KEY=                    # 用真实 Claude 生成决策理由时填
LLM_MODEL=claude-opus-4-8

# --- 真实写链开关（默认关闭，安全）---
# 仅当你本人确认后再开启；recordDecision 只写存证、不动资金，但仍需 gas。
ENABLE_ONCHAIN_WRITE=false
AGENT_PRIVATE_KEY=                     # operator 私钥（0x...）；仅 ENABLE_ONCHAIN_WRITE=true 时使用
