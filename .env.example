# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# ⚠️ 私钥仅由你本人填入；Claude Code 不读写、不使用此文件中的密钥。

# --- Mantle Sepolia (chainId 5003) ---
MANTLE_SEPOLIA_RPC_URL=        # 见 https://chainlist.org/chain/5003
PRIVATE_KEY=                   # 测试网部署私钥（0x...），仅你本人填

# --- 可选：源码 verify（官方提交不要求）---
EXPLORER_API_KEY=
EXPLORER_VERIFY_URL=

# --- Agent 后端 ---
LLM_API_KEY=                   # 你的 LLM key（决策模块用）
BYREAL_POOL_ID=                # 目标 Byreal 池 id

# --- Web ---
VITE_REGISTRY_ADDRESS=         # 部署后回填的 LPAgentRegistry 地址
